{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ploots Click",
  "version": "1.0.0",
  "identifier": "io.github.defani.plootsclick",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ploots Click",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Defani Arman Alfitriansyah",
    "copyright": "Copyright (c) 2026 Defani Arman Alfitriansyah",
    "category": "Productivity",
    "shortDescription": "Charts, maps and page layout, offline",
    "longDescription": "Ploots Click desktop: publication charts, a GIS map workspace with print layout, and KoboToolbox monitoring. Runs on your computer; files you open are never uploaded.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser", "installerIcon": "icons/icon.ico" }
    }
  }
}
